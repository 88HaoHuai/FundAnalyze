{
    "rewrites": [
        {
            "source": "/api/fund/:match*",
            "destination": "http://fundgz.1234567.com.cn/js/:match*"
        },
        {
            "source": "/api/pingzhong/:match*",
            "destination": "/api/pingzhong-proxy?path=:match*"
        },
        {
            "source": "/api/f10/:match*",
            "destination": "/api/f10-proxy?path=:match*"
        },
        {
            "source": "/api/stock",
            "destination": "/api/stock-proxy"
        }
    ],
    "crons": [
        {
            "path": "/api/auto_invest",
            "schedule": "30 15 * * 1-5"
        }
    ]
}